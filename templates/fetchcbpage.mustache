{{!
    @template mod_wordcards/fetchcbpage

    Explains the in app free trial and opens the Chargebee checkout on demand. The Chargebee
    details are passed to mod_wordcards/cbfreetrial from PHP, not from this template.

    Example context (json):
    {
        "wwwroot": "https://mymoodle.com",
        "settingsurl": "https://mymoodle.com/admin/settings.php?section=modsettingwordcards"
    }
}}
<div class="mod_wordcards_cbfreetrial">
    <p>{{#str}}freetrial_desc, mod_wordcards{{/str}}</p>

    <ol class="mod_wordcards_cbfreetrial_steps">
        <li>{{#str}}cbtrialstep1, mod_wordcards{{/str}}</li>
        <li>{{#str}}cbtrialstep2, mod_wordcards{{/str}}</li>
        <li>{{#str}}cbtrialstep3, mod_wordcards{{/str}}</li>
    </ol>

    <div class="alert alert-info">
        {{#str}}cbtrialsiteurl, mod_wordcards{{/str}}
        <strong>{{wwwroot}}</strong>
        <div class="small">{{#str}}cbtrialsiteurl_desc, mod_wordcards{{/str}}</div>
    </div>

    <p>
        <button type="button" class="btn btn-primary btn-lg" data-action="cbstarttrial">
            {{#str}}cbgetfreetrial, mod_wordcards{{/str}}
        </button>
    </p>

    <div class="alert alert-success d-none" data-region="cbaftercheckout">
        <h4>{{#str}}cbaftercheckout, mod_wordcards{{/str}}</h4>
        <p class="mb-0">{{#str}}cbaftercheckout_desc, mod_wordcards{{/str}}</p>
    </div>

    <p>
        <a href="{{{settingsurl}}}">{{#str}}cbgotosettings, mod_wordcards{{/str}}</a>
    </p>
</div>
