{{!
    @template mod_wordcards/ww_added

    A word the Word Wizard has added, in its list of what has been added.

    Example context (json):
    {
        "term": "bank", "definition": "a place for money"
    }
}}
<li class="list-group-item mod_wordcards_ww_addeditem">
    <strong>{{term}}</strong>
    <span class="text-muted">{{definition}}</span>
</li>
