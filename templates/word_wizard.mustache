{{!
    @template mod_wordcards/word_wizard

    The Word Wizard: look words up, choose a meaning of each, and see what has been added.

    Example context (json):
    {
        "cmid": 3, "modid": 2, "langterm": "en", "managewordsurl": "#",
        "langdefs": [{"code": "ja", "name": "Japanese", "selected": true}]
    }
}}
<div class="mod_wordcards_ww_cont" id="{{uniqid}}_ww">
    <div class="card mb-3 mod_wordcards_ww_search">
        <div class="card-body">
            <label for="{{uniqid}}_ww_words">{{#str}}ww_words_label, mod_wordcards{{/str}}</label>
            <textarea id="{{uniqid}}_ww_words" class="form-control mod_wordcards_ww_words" name="ww_words" rows="4"
                placeholder="{{#str}}ww_words, mod_wordcards{{/str}}"></textarea>
            <div class="mod_wordcards_ww_searchbar">
                <div class="mod_wordcards_ww_langdef">
                    <label for="{{uniqid}}_ww_langdef" class="mb-0">{{#str}}ww_langdef, mod_wordcards{{/str}}</label>
                    <select id="{{uniqid}}_ww_langdef" name="ww_langdef" class="custom-select">
                        {{#langdefs}}
                            <option value="{{code}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                        {{/langdefs}}
                    </select>
                </div>
                <button type="button" class="btn btn-primary ww_words_fetch_btn" id="{{uniqid}}_fetchbtn">
                    {{#str}}ww_words_fetch, mod_wordcards{{/str}}
                </button>
            </div>
        </div>
    </div>

    <div class="card mb-3 mod_wordcards_ww_added" id="{{uniqid}}_added" hidden>
        <div class="card-header mod_wordcards_ww_addedheader">
            <h4 class="h6 mb-0">
                {{#str}}ww_added_heading, mod_wordcards{{/str}}
                (<span class="mod_wordcards_ww_addedcount">0</span>)
            </h4>
            <a href="{{managewordsurl}}">{{#str}}ww_managewords, mod_wordcards{{/str}}</a>
        </div>
        <ul class="list-group list-group-flush mod_wordcards_ww_addedlist"></ul>
    </div>

    <div id="{{uniqid}}_resultscont" class="mod_wordcards_ww_results"></div>
</div>
<hr>
<div class="mod_wordcards_ww_image_cont">
  <h4>{{#str}}bulkimagewizard, mod_wordcards {{/str}}</h4>
  <div>{{#str}}ww_bulk_images_instructions, mod_wordcards {{/str}}</div><br />
  <a class="btn btn-primary ww_words_fetch_image_btn" id="{{uniqid}}_fetchimagebtn">{{#str}}ww_images_fetch, mod_wordcards{{/str}}</a>
  <div id="{{uniqid}}_image_resultscont" class="mod_wordcards_ww_image_results" style="display: none">
  </div>
</div>

<hr>
<div class="mod_wordcards_ww_sync_cont">
  <h4>{{#str}}ww_syncsentences, mod_wordcards {{/str}}</h4>
  <div>{{#str}}ww_syncsentences_instructions, mod_wordcards {{/str}}</div><br />
  <a class="btn btn-primary ww_sync_sentences_btn" id="{{uniqid}}_syncbtn">{{#str}}ww_syncsentences_btn, mod_wordcards{{/str}}</a>
  <div id="{{uniqid}}_sync_results" class="mod_wordcards_ww_sync_results"></div>
</div>

{{^element.frozen}}
    {{#js}}
        require(['jquery','core/log','core/templates','core/ajax','mod_wordcards/dictlookup', 'mod_wordcards/bulkimagegen'],function($,log,templates,ajax,  dictlookup, bulkimagegen) {

            //Init bulk image generation
            bulkimagegen.init({{cmid}});

            //fetch the translated example sentences for words that have none yet
            var syncresults = $("#{{uniqid}}_sync_results");
            $("#{{uniqid}}_syncbtn").on("click", function() {
                var btn = $(this);
                if (btn.hasClass("disabled")) {
                    return;
                }
                btn.addClass("disabled");
                syncresults.text("{{#str}}ww_syncsentences_working, mod_wordcards{{/str}}");
                ajax.call([{
                    methodname: "mod_wordcards_sync_sentence_translations",
                    args: {cmid: {{cmid}}}
                }])[0].done(function(response) {
                    syncresults.text(response.message);
                    btn.removeClass("disabled");
                }).fail(function(err) {
                    log.debug(err);
                    syncresults.text("{{#str}}ww_syncsentences_failed, mod_wordcards{{/str}}");
                    btn.removeClass("disabled");
                });
            });

            //look words up and add the chosen meanings
            dictlookup.init({
                cmid: {{cmid}},
                modid: {{modid}},
                langterm: '{{langterm}}',
                root: '#{{uniqid}}_ww'
            });

        });//end of require
    {{/js}}
{{/element.frozen}}