{{!
    @template mod_wordcards/scatter_cards

    The shuffled grid of cards for the Scatter activity. Each pair of cards shares a key,
    one card showing the term and the other showing the definition, a picture, or both.

    Context variables required for this template:
    * cards - array of cards, each with key, cardindex, isterm, showtext, text, showimage,
              image, imagealt and hasboth

    Example context (json):
    {
        "cards": [
            {"key": 0, "cardindex": 0, "isterm": true, "showtext": true, "text": "airport"},
            {"key": 0, "cardindex": 1, "showtext": true, "text": "where planes land"}
        ]
    }
}}
{{#cards}}
  <div class="wordcards-scatter-card a4e-noselect {{#isterm}}wordcards-scatter-term{{/isterm}}{{^isterm}}wordcards-scatter-def{{/isterm}}{{#hasboth}} wordcards-scatter-hasboth{{/hasboth}}"
       data-key="{{key}}" data-cardindex="{{cardindex}}" tabindex="0" role="button" aria-pressed="false">
    {{#showimage}}
      <div class="wordcards-scatter-cardimage"><img src="{{image}}" alt="{{imagealt}}"/></div>
    {{/showimage}}
    {{#showtext}}
      <div class="wordcards-scatter-cardtext" dir="auto">{{{text}}}</div>
    {{/showtext}}
  </div>
{{/cards}}
