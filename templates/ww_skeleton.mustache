{{!
    @template mod_wordcards/ww_skeleton

    A word in the Word Wizard's results while it is being looked up.

    Example context (json):
    {
        "term": "bank"
    }
}}
<div class="card mb-3 mod_wordcards_ww_word mod_wordcards_ww_loading" aria-busy="true">
    <div class="card-header mod_wordcards_ww_wordheader">
        <h4 class="h5 mb-0 mod_wordcards_ww_term">{{term}}</h4>
        <span class="small text-muted">{{#str}}ww_lookingup, mod_wordcards{{/str}}</span>
    </div>
    <div class="card-body">
        <div class="mod_wordcards_skeleton_box mod_wordcards_ww_skeletonline"></div>
        <div class="mod_wordcards_skeleton_box mod_wordcards_ww_skeletonline mod_wordcards_ww_skeletonshort"></div>
    </div>
</div>
