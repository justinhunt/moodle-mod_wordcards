<div class="mod_wordcards_word_wizard_oneresult" id="{{uniqid}}_oneresult">
    <fieldset class="mod_wordcards_ww_fieldset border p-2">
        <legend class="w-auto">{{term}}</legend>
        <div class="container ml-0">
            <div class="row">
            {{#nosenses}}
                <div class="col-sm mod_wordcards_ww_onesense" id="{{uniqid}}_0_onesense">
                    <div class="mod_wordcards_ww_sourcedef">{{#failed}}{{#str}}ww_lookupfailed, mod_wordcards {{/str}}{{/failed}}{{^failed}}{{#str}}nodefinitionfound, mod_wordcards {{/str}}{{/failed}}</div>
                </div>
            {{/nosenses}}
            {{#senses}}
                <div class="col-sm-4 mod_wordcards_ww_onesense" id="{{uniqid}}_{{senseindex}}_onesense">
                    <span style="display: none" class="mod_wordcards_ww_sourcedef">{{sourcedefinition}}</span>
                    <span style="display: none" class="mod_wordcards_ww_trans">{{translations}}</span>
                    <span style="display: none" class="mod_wordcards_ww_senttrans">{{modelsentencetranslations}}</span>
                    <label class="mod_wordcards_ww_label">{{#str}}definition, mod_wordcards {{/str}}</label><input type="text" class="mod_wordcards_ww_def" value="{{definition}}"{{^hasdefinition}} placeholder="{{#str}}ww_notranslation, mod_wordcards {{/str}}"{{/hasdefinition}}><br>
                    <label class="mod_wordcards_ww_label">{{#str}}model_sentence, mod_wordcards {{/str}}</label><textarea class="mod_wordcards_ww_modelsentence" rows="3" data-original="{{modelsentence}}">{{modelsentence}}</textarea><br>
                    <button class="mod_wordcards_ww_use {{uniqid}}_usebutton" data-senseindex="{{senseindex}}" type='button'>{{#str}}use, mod_wordcards {{/str}}</button>
                    <button class="mod_wordcards_ww_dismiss {{uniqid}}_dismissbutton" data-senseindex="{{senseindex}}" type='button'>{{#str}}dismiss, mod_wordcards {{/str}}</button>
                </div>
            {{/senses}}
            </div>
        </div>
    </fieldset>
</div>
{{^element.frozen}}
    {{#js}}
        require(['jquery','core/ajax'],function($,ajax) {

            //remove the box
            $(".{{uniqid}}_dismissbutton").unbind(); // bad hack to prevent multiple bindings from where?
            $(".{{uniqid}}_dismissbutton").on("click", function() {
                var senseindex = $(this).data('senseindex');
                $("#{{uniqid}}_" + senseindex + "_onesense").remove();
            });

            //Update the textbox
            $(".{{uniqid}}_usebutton").unbind(); // bad hack to prevent multiple bindings from where?
            $(".{{uniqid}}_usebutton").on("click", function() {
                var that = this;
                var senseindex = $(this).data('senseindex');
                var definition = $("#{{uniqid}}_" + senseindex + "_onesense .mod_wordcards_ww_def").val();
                var sourcedef = $("#{{uniqid}}_" + senseindex + "_onesense .mod_wordcards_ww_sourcedef").text();
                var translations = $("#{{uniqid}}_" + senseindex + "_onesense .mod_wordcards_ww_trans").text();
                var senttrans = $("#{{uniqid}}_" + senseindex + "_onesense .mod_wordcards_ww_senttrans").text();
                var sentencebox = $("#{{uniqid}}_" + senseindex + "_onesense .mod_wordcards_ww_modelsentence");
                var modelsentence = sentencebox.val();
                //The translations we hold are of the sentence the dictionary gave us. If the teacher has
                //rewritten it they no longer describe what will be on the card, so drop them and say so:
                //the server queues a different task for a sentence of its own.
                var sentenceedited = 0;
                if ($.trim(modelsentence) !== $.trim(sentencebox.attr('data-original') || '')) {
                    senttrans = '';
                    sentenceedited = 1;
                }


                var promises = ajax.call([
                    { methodname: 'mod_wordcards_submit_newterm',
                        args: { modid: {{modid}}, term: "{{term}}", definition: definition,
                                sourcedef: sourcedef, translations: translations,
                                modelsentence: modelsentence, modelsentencetranslations: senttrans,
                                sentenceedited: sentenceedited}
                    }
                ]);

                //update button
                promises[0].done(function(response) {
                    $(that).text('submitted').unbind();
                    $(that).attr('disabled',true);
                });

            });
        });//end of require
    {{/js}}
{{/element.frozen}}