{{!
    @template mod_wordcards/word_wizard_oneresult

    One word in the Word Wizard's results: each meaning the dictionary found, to choose one from.
    Rendered by amd/src/dictlookup.js, which handles the buttons.

    Example context (json):
    {
        "term": "bank", "found": true,
        "senses": [{"senseindex": 0, "definition": "a place for money", "hasdefinition": true,
            "modelsentence": "I put my wages in the bank."}]
    }
}}
<div class="card mb-3 mod_wordcards_ww_word">
    <div class="card-header mod_wordcards_ww_wordheader">
        <h4 class="h5 mb-0 mod_wordcards_ww_term">{{term}}</h4>
        {{^alreadyinset}}{{#found}}
            <span class="small text-muted mod_wordcards_ww_choose">{{#str}}ww_choosesense, mod_wordcards{{/str}}</span>
        {{/found}}{{/alreadyinset}}
        <button type="button" class="btn btn-link btn-sm mod_wordcards_ww_skip" data-action="skip"
            aria-label="{{#str}}ww_skipword, mod_wordcards, {{term}}{{/str}}">{{#str}}ww_skip, mod_wordcards{{/str}}</button>
    </div>
    {{#alreadyinset}}
        <div class="card-body">
            <p class="mb-0 text-muted">{{#str}}ww_alreadyinset, mod_wordcards{{/str}}</p>
        </div>
    {{/alreadyinset}}
    {{^alreadyinset}}
        {{#failed}}
            <div class="card-body mod_wordcards_ww_failed">
                <p class="mb-0">{{#str}}ww_lookupfailed, mod_wordcards{{/str}}</p>
                <button type="button" class="btn btn-secondary btn-sm" data-action="retry">{{#str}}ww_retry, mod_wordcards{{/str}}</button>
            </div>
        {{/failed}}
        {{^failed}}{{^found}}
            <div class="card-body">
                <p class="mb-0 text-muted">{{#str}}nodefinitionfound, mod_wordcards{{/str}}</p>
            </div>
        {{/found}}{{/failed}}
        {{#found}}
            <ul class="list-group list-group-flush">
                {{#senses}}
                    <li class="list-group-item mod_wordcards_ww_sense" data-senseindex="{{senseindex}}">
                        <div class="mod_wordcards_ww_senseview">
                            <div class="mod_wordcards_ww_sensetext">
                                <div class="mod_wordcards_ww_def"
                                    data-empty="{{#str}}ww_notranslation, mod_wordcards{{/str}}">{{definition}}</div>
                                <div class="mod_wordcards_ww_sentence text-muted"
                                    data-empty="{{#str}}ww_nosentence, mod_wordcards{{/str}}">{{modelsentence}}</div>
                            </div>
                            <div class="mod_wordcards_ww_senseactions">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="edit"
                                    aria-expanded="{{^hasdefinition}}true{{/hasdefinition}}{{#hasdefinition}}false{{/hasdefinition}}">
                                    {{#str}}ww_edit, mod_wordcards{{/str}}
                                </button>
                                <button type="button" class="btn btn-primary btn-sm" data-action="use">
                                    {{#str}}ww_usethis, mod_wordcards{{/str}}
                                </button>
                            </div>
                        </div>
                        <div class="mod_wordcards_ww_senseedit" {{#hasdefinition}}hidden{{/hasdefinition}}>
                            <label for="{{uniqid}}_{{senseindex}}_def">{{#str}}definition, mod_wordcards{{/str}}</label>
                            <input type="text" id="{{uniqid}}_{{senseindex}}_def" class="form-control mod_wordcards_ww_defedit"
                                value="{{definition}}" placeholder="{{#str}}ww_notranslation, mod_wordcards{{/str}}">
                            <label for="{{uniqid}}_{{senseindex}}_sentence">{{#str}}model_sentence, mod_wordcards{{/str}}</label>
                            <textarea id="{{uniqid}}_{{senseindex}}_sentence" class="form-control mod_wordcards_ww_sentenceedit"
                                rows="2">{{modelsentence}}</textarea>
                        </div>
                        <div class="small text-danger mod_wordcards_ww_senseerror" role="alert" hidden></div>
                    </li>
                {{/senses}}
            </ul>
        {{/found}}
    {{/alreadyinset}}
</div>
