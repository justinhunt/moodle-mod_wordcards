{{!
    @template mod_wordcards/ww_bgstatus

    What is still being done in the background for an activity: words being added, pictures
    being made. Shown on the Word Wizard and Manage words pages, and kept up to date by
    amd/src/bgstatus.js, which renders it again with new numbers.

    Example context (json):
    {
        "cmid": 3, "active": true, "words": 4, "haswords": true, "hasimages": true, "hasretrying": false
    }
}}
<div class="mod_wordcards_ww_bgstatus" data-region="mod_wordcards_bgstatus" data-cmid="{{cmid}}"
    {{#reloadurl}}data-reloadurl="{{reloadurl}}"{{/reloadurl}} data-active="{{#active}}1{{/active}}{{^active}}0{{/active}}">
    {{#active}}
        <div class="alert alert-info mod_wordcards_ww_bgalert" role="status">
            <i class="icon fa fa-spinner fa-spin fa-fw" aria-hidden="true"></i>
            <div>
                {{#haswords}}<div>{{#str}}ww_bg_words, mod_wordcards, {{words}}{{/str}}</div>{{/haswords}}
                {{#hasimages}}<div>{{#str}}ww_bg_images, mod_wordcards{{/str}}</div>{{/hasimages}}
                {{#hasretrying}}<div>{{#str}}ww_bg_retrying, mod_wordcards{{/str}}</div>{{/hasretrying}}
                <div class="small">{{#str}}ww_bg_when, mod_wordcards{{/str}}</div>
            </div>
        </div>
    {{/active}}
    {{#done}}
        <div class="alert alert-success" role="status">
            {{#str}}ww_bg_done, mod_wordcards{{/str}}
            <a href="{{reloadurl}}">{{#str}}ww_bg_reload, mod_wordcards{{/str}}</a>
        </div>
    {{/done}}
</div>
