<div class="a4e-flashcards-container">

  <button class='btn btn-block btn-lg btn-primary mod_wordcards_matching_frontbtn'>
    <i class="fa fa-retweet"></i> {{#str}}flip, mod_wordcards{{/str}}
  </button>

   <audio id="poodll_vocabplayer"></audio>

  {{#terms}}

    <div class="a4e-card a4e-noselect {{#showimageflip}}wordcards_portrait{{/showimageflip}}" tabindex="0" role="button" aria-pressed="false">

    {{#frontfacedef}}
      <div class="wordcards_defcard front">
          {{#showimageflip}}{{#image}}
          <div class="wordcards_cardimage"><img src="{{image}}" alt=""/></div>
          {{/image}}{{/showimageflip}}
          <div class="wordcards_cardtext">{{{definition}}}</div>
      </div>
        <div class="wordcards_termcard back">
            {{#showimageflip}}{{#image}}
            <div class="wordcards_cardimage"><img src="{{image}}" alt=""/></div>
            {{/image}}{{/showimageflip}}
            <button class="play-tts btn btn-secondary btn-sm" data-modelaudio="{{audio}}" data-tts="{{term}}" data-ttsvoice="{{ttsvoice}}">
                <i class="fa fa-volume-up"></i>
            </button>
            <div class="wordcards_cardtext">{{term}}</div>
        </div>
    {{/frontfacedef}}
  {{^frontfacedef}}
      <div class="wordcards_termcard front">
          {{#showimageflip}}{{#image}}
          <div class="wordcards_cardimage"><img src="{{image}}" alt=""/></div>
          {{/image}}{{/showimageflip}}
          <button class="play-tts btn btn-secondary btn-sm" data-modelaudio="{{audio}}" data-tts="{{term}}" data-ttsvoice="{{ttsvoice}}">
              <i class="fa fa-volume-up"></i>
          </button>
          <div class="wordcards_cardtext">{{term}}</div>
      </div>
      <div class="wordcards_defcard back">
          {{#showimageflip}}{{#image}}
          <div class="wordcards_cardimage"><img src="{{image}}" alt=""/></div>
          {{/image}}{{/showimageflip}}
          <div class="wordcards_cardtext">{{{definition}}}</div>
      </div>

  {{/frontfacedef}}



    </div>

  {{/terms}}

</div>

<button id='wordcards-start-button' class='btn btn-success btn-lg center-block btn-block'>
  <i class='fa fa-play'></i> {{#str}}starttest, mod_wordcards{{/str}}
</button>
